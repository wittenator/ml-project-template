Bootstrap: docker
From: python:3.12-slim

%files
    pyproject.toml /pyproject.toml
    uv.lock /uv.lock
    README.md /README.md

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PYTHONPATH=./src:$PYTHONPATH
    export UV_PROJECT_ENVIRONMENT="/.venv"
    export UV_PYTHON_INSTALL_DIR="/python"
    export UV_COMPILE_BYTECODE=1
    export UV_LINK_MODE=copy
    export PATH="$UV_PROJECT_ENVIRONMENT/bin:$PATH"
%post
    apt update && apt install openssh-client build-essential git wget -y
    pip install --root-user-action=ignore --no-cache-dir uv
    uv sync --frozen --no-dev --no-install-project

    # SSH wrappers around the slurm commands so they can be invoked from inside
    # the container. The login host comes from $COMMAND_EXECUTION_NODE at
    # runtime (defaulting to $HOSTNAME for in-cluster use). $SSH_OPTIONS is the
    # extension point for clusters that need extra ssh flags (e.g.
    # `export SSH_OPTIONS="-i /sshkeys/login_id_ed25519"`) so credentials never
    # get baked into the image.
    for cmd in sacct sacctmgr salloc sattach sbatch sbcast scancel scontrol \
               sdiag sgather sinfo smap sprio squeue sreport srun sshare \
               sstat strigger sview; do
        cat > /usr/local/bin/$cmd <<EOF
#!/bin/bash
exec ssh \$SSH_OPTIONS "\$USER@\${COMMAND_EXECUTION_NODE:-\$HOSTNAME}" $cmd "\$@"
EOF
        chmod 755 /usr/local/bin/$cmd
    done