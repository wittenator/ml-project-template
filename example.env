WANDB_API_KEY=45627890....
WANDB_ENTITY=a-username
WANDB_PROJECT=dev_test

# Optional: shared cache root for wandb/etc., kept off $HOME (handy on clusters
# with a small home quota). Defaults to <cwd>/.cache; cluster jobs set it to the
# node-local /cache scratch mount automatically.
# CACHE_DIR=/path/to/scratch/cache
